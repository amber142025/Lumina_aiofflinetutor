# Copy to .env for local development only. Never commit real credentials.
APP_ENV=development
DATABASE_URL=sqlite:///./lumina_dev.db
JWT_SECRET=replace-with-a-long-random-secret-for-local-development
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-6-luna

# Production must use managed PostgreSQL, a unique secret, real HTTPS origins,
# and the hosting provider's secret/environment settings. Do not deploy these defaults.
